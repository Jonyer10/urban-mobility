PORT=3000
GEMINI_API_KEY=TU_CLAVE_AQUI
# Modelos gratuitos de Gemini, en orden de preferencia (si uno agota su cuota diaria se usa el siguiente)
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
# La búsqueda de Google en el chat NO tiene cuota gratuita; actívala solo con facturación habilitada
# GEMINI_USE_SEARCH=false

# Geolocalización: ciudad por defecto y caja de búsqueda (izq,arriba,der,abajo) de Nominatim/Overpass
# DEFAULT_CITY=Bogotá
# GEO_VIEWBOX=-74.25,4.84,-73.99,4.45

# Base de datos SQLite (casos + caché). Se crea sola; por defecto en backend/data/urban.db
# DB_PATH=./data/urban.db

# Puedes usar DATABASE_URL o las variables individuales de PostgreSQL.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/urban-mobility
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=urban-mobility
# DB_USER=public_user
# DB_PASSWORD=TU_PASSWORD